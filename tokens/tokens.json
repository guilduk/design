  "contrast": {
    "$comment": "Pairs that must pass. [text, background, minimum]. 4.5 for words, 3 for large headings, icons and lines.",
    "pairs": [
      ["light.text", "light.background", 4.5],
      ["light.text-muted", "light.background", 4.5],
      ["light.heading", "light.background", 4.5],
      ["light.emphasis", "light.background", 3],
      ["light.link", "light.background", 4.5],
      ["light.text", "light.surface-soft", 4.5],
      ["light.heading", "light.surface-soft", 4.5],
      ["light.text-muted", "light.surface-soft", 4.5],
      ["light.action-text", "light.action", 4.5],
      ["light.action-text", "light.action-hover", 4.5],
      ["brand.white", "light.surface-dark", 4.5],
      ["light.accent", "light.surface-dark", 4.5],
      ["brand.ink", "light.accent", 4.5],
      ["light.danger", "light.background", 4.5],
      ["light.danger", "light.danger-soft", 4.5],
      ["light.warning", "light.background", 4.5],
      ["light.warning", "light.warning-soft", 4.5],
      ["light.success", "light.background", 4.5],
      ["light.success", "light.success-soft", 4.5],
      ["light.line-strong", "light.background", 3],
      ["light.focus", "light.background", 3],
      ["dark.text", "dark.background", 4.5],
      ["dark.text", "dark.surface", 4.5],
      ["dark.text", "dark.surface-soft", 4.5],
      ["dark.text-muted", "dark.background", 4.5],
      ["dark.text-muted", "dark.surface", 4.5],
      ["dark.text-muted", "dark.surface-soft", 4.5],
      ["dark.heading", "dark.surface", 4.5],
      ["dark.emphasis", "dark.background", 3],
      ["dark.emphasis", "dark.surface", 3],
      ["dark.link", "dark.background", 4.5],
      ["dark.link", "dark.surface", 4.5],
      ["dark.accent", "dark.background", 4.5],
      ["dark.action-text", "dark.action", 4.5],
      ["dark.action-text", "dark.action-hover", 4.5],
      ["dark.danger", "dark.surface", 4.5],
      ["dark.danger", "dark.danger-soft", 4.5],
      ["dark.warning", "dark.surface", 4.5],
      ["dark.warning", "dark.warning-soft", 4.5],
      ["dark.success", "dark.surface", 4.5],
      ["dark.success", "dark.success-soft", 4.5],
      ["dark.line-strong", "dark.surface", 3],
      ["dark.focus", "dark.background", 3]

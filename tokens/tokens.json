  "font": {
    "serif": "\"DM Serif Display\", Georgia, \"Times New Roman\", serif",
    "sans": "\"DM Sans\", system-ui, -apple-system, \"Segoe UI\", Arial, sans-serif",
    "email-serif": "Georgia, \"Times New Roman\", serif",
    "email-sans": "Arial, Helvetica, sans-serif",
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
  },
  "size": {
    "display": "clamp(42px, 6.2vw, 92px)",
    "h1": "clamp(36px, 4.6vw, 58px)",
    "h2": "clamp(30px, 3.2vw, 43px)",
    "h3": "clamp(22px, 2vw, 29px)",
    "lead": "clamp(17px, 1.35vw, 20px)",
    "body": "16px",
    "small": "14px",
    "caption": "13px",
    "eyebrow": "12px"
  },
  "leading": { "display": "1.05", "heading": "1.13", "body": "1.7", "tight": "1.3" },
  "tracking": { "display": "-0.01em", "eyebrow": "0.16em" },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px", "9": "86px" },
  "gutter": { "phone": "6%", "tablet": "5%", "desktop": "7.5%" },
  "width": { "text": "68ch", "content": "1280px", "wide": "1800px" },
  "radius": { "sm": "3px", "md": "6px", "lg": "20px", "round": "999px" },
  "shadow": {
    "soft": "0 2px 10px rgba(20, 32, 25, 0.14)",
    "panel": "0 30px 60px -30px rgba(20, 32, 25, 0.45)"
  },
  "target": { "min": "24px", "comfortable": "44px", "field": "46px" },
  "breakpoint": { "phone": "640px", "tablet": "1024px", "desktop": "1100px", "wide": "1600px" },
  "motion": {
    "fast": "150ms",
    "base": "250ms",
    "slow": "600ms",
    "reveal": "800ms",
    "ease-out": "cubic-bezier(0.23, 1, 0.32, 1)",
    "ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
    "drawer": "cubic-bezier(0.32, 0.72, 0, 1)"
  },
  "z": { "header": 40, "overlay": 50, "menu": 60, "toast": 70 }
}
